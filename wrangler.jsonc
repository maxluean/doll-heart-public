{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doll-heart-public",
  "pages_build_output_dir": "./.pages",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "preview": {
      "vars": {
        "APP_MODE": "public",
        "SHOP_MODE": "disabled",
        "PAYMENTS_MODE": "test",
        "PAYMENTS_LIVE_ENABLED": "false",
        "GUEST_GIFTS_ENABLED": "false"
      }
    }
  },
  "vars": {
    "APP_ORIGIN": "https://YOUR_PROJECT.pages.dev",
    "APP_MODE": "public",
    "SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
    "SHOP_MODE": "paid",
    "PAYMENTS_MODE": "test",
    "PAYMENTS_LIVE_ENABLED": "false",
    "STRIPE_PAYMENT_METHOD_CONFIG": "",
    "GUEST_GIFTS_ENABLED": "true"
  }
}
