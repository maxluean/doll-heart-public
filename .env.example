# Copy to .env.local for local use. Enter production values as Cloudflare Pages Production secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy account mode; guest gifts do not invoke Supabase Auth.
GUEST_GIFTS_ENABLED=true
# public: verified Google identities can still read legacy account data.
APP_MODE=public
# Optional legacy private mode only (APP_MODE=private).
OWNER_EMAIL=
# Exact deployed origin, e.g. https://YOUR_PROJECT.pages.dev (no trailing slash)
APP_ORIGIN=
# paid: PromptPay checkout only when matching keys are present; no implicit live charges.
SHOP_MODE=paid
PAYMENTS_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIG=
PAYMENTS_LIVE_ENABLED=false
